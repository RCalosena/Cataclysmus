for armor in bronze {
        armor.anyDamage().addTooltip("§fPower Strike");
        armor.anyDamage().addTooltip("Critical Hits are more effective. You can enrage by crouch-jumping when hit 5 times. Stored Rage damages you over time and more every time you are hit. The more hits you resist the stronger the Rage will be. Activating Rage will give you +40% damage reduction and will also heal you.");
}


        <metallurgy:amordrine_helmet>,
        <cqrepoured:helmet_iron_dyable>,
        <metallurgy:astral_silver_helmet>,
        <metallurgy:hepatizon_helmet>,
        <metallurgy:desichalkos_helmet>,

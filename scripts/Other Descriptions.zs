        # Stealth Descriptions #

<mysticalworld:silver_sword>.anyDamage().addTooltip(format.gold("Stealth Strikes make the victim glow for 10 seconds"));
<mysticalworld:copper_sword>.anyDamage().addTooltip(format.gold("Stealth Strikes give you Static Aura for 10 seconds"));
<mysticalworld:amethyst_sword>.anyDamage().addTooltip(format.gold("Stealth Strikes launch the victim into the air"));
<nyx:meteor_sword>.anyDamage().addTooltip(format.gold("Stealth Strikes make the victim explode"));
<midnight:tenebrum_sword>.anyDamage().addTooltip(format.gold("Stealth Strikes corrode the victim's armor for 5 seconds"));
<midnight:nagrilite_sword>.anyDamage().addTooltip(format.gold("Stealth Strikes inflict Giration for 5 seconds"));
<midnight:ebonys_sword>.anyDamage().addTooltip(format.gold("Stealth Strikes inflict Fear for 5 seconds"));
<midnight:nightstone_sword>.anyDamage().addTooltip(format.gold("Stealth Strikes give you Leech for 2.5 seconds"));
<midnight:shadowroot_sword>.anyDamage().addTooltip(format.gold("Stealth Strikes inflict Blindness for 5 seconds"));


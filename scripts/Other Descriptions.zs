        <metallurgy:atlarus_boots>,
        <metallurgy:midasium_boots>,
        <mod_lavacow:swinearmor_boots>
] as IItemStack[];

for armor in warlock {
        armor.anyDamage().addTooltip("§dWarlock");
        armor.anyDamage().addTooltip("You get a different permanent potion effect depending on the wand held. Each spell-casted effect further increases Magic Damage.");
}


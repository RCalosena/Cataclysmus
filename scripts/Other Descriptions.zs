        <mod_lavacow:swinearmor_chestplate>,
        <metallurgy:platinum_leggings>,
        <metallurgy:vyroxeres_leggings>,
        <metallurgy:ceruclase_leggings>,
        <metallurgy:atlarus_leggings>,

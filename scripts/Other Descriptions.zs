for armor in assassin {
        armor.anyDamage().addTooltip("§3Assassin");
        armor.anyDamage().addTooltip("Sneaking in darkness or bushes builds up Stealth. Crouch-Jump after Stored Stealth activates to enter Stealth Mode. Building up stealth for too long triggers Madness Mode (x5 Damage but reduced range).");
}

